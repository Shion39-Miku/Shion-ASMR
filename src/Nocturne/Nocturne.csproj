<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>Nocturne</AssemblyName><Version>1.14.0</Version><Product>月咲 Shion</Product><Title>月咲 Shion</Title><Description>月咲 Shion 本地音声播放器</Description>
    <AssemblyTitle>月咲 Shion</AssemblyTitle><PlatformTarget>x64</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>$(BaseIntermediateOutputPath)shion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1"/><PackageReference Include="NAudio.Vorbis" Version="1.5.0"/><PackageReference Include="SkiaSharp" Version="3.119.4"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/*.ttf"/><Resource Include="Assets/Brand/shion.png"/><Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <Target Name="BuildBrandIcon" BeforeTargets="PrepareForBuild" Inputs="Assets/Brand/shion.png;$(MSBuildThisFileDirectory)..\..\scripts\build-icon.ps1" Outputs="$(ApplicationIcon)">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\build-icon.ps1&quot; -Output &quot;$(ApplicationIcon)&quot;" />
  </Target>
</Project>
